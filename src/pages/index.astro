---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Homepage" description="Rajeev's Portfolio Homepage">
  <main>
    <section class="card" aria-labelledby="profile-heading">
      <div class="card-header">
        <h1 id="profile-heading">Rajeev Athreya Jawaji</h1>
        <p class="role">Software Engineer</p>
        <p class="summary">
          I enjoy building software and exploring how things work under the
          hood, especially low-level systems.
        </p>
      </div>
      <nav aria-label="Social Links">
        <a href="https://au.linkedin.com/in/rjawaji">
          <Icon
            name="fontawesome/brands/linkedin"
            width={22}
            height={22}
            aria-hidden={true}
          />
          LinkedIn
        </a>
        <a href="https://github.com/rjawaji1">
          <Icon
            name="fontawesome/brands/github"
            width={22}
            height={22}
            aria-hidden={true}
          />
          GitHub
        </a>
        <a href="https://codeberg.org/rjawaji">
          <Icon
            name="fontawesome/brands/codeberg"
            width={22}
            height={22}
            aria-hidden={true}
          />
          Codeberg
        </a>
        <a href="mailto:rajeev@jawaji.com">
          <Icon
            name="fontawesome/solid/envelope"
            width={22}
            height={22}
            aria-hidden={true}
          />
          Email
        </a>
      </nav>
    </section>
  </main>
</Layout>
